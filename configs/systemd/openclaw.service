[Unit]
Description=OpenClaw autonomous agent
Documentation=https://github.com/YawnsDuzin/openclaw-on-pi
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=openclaw
Group=openclaw
WorkingDirectory=/opt/openclaw
EnvironmentFile=-/etc/openclaw/openclaw.env
ExecStart=/usr/bin/openclaw run --config /etc/openclaw/openclaw.yaml
Restart=on-failure
RestartSec=10s
TimeoutStopSec=30s
KillMode=mixed

# --- 강화된 sandbox ----------------------------------------------------------
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/openclaw /var/log/openclaw
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=false
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=

# --- 리소스 제한 (Pi 4 4GB 기준 보수적 값) ----------------------------------
MemoryHigh=2G
MemoryMax=2.5G
TasksMax=512

# --- 로그 ---------------------------------------------------------------------
StandardOutput=append:/var/log/openclaw/openclaw.log
StandardError=append:/var/log/openclaw/openclaw.err

[Install]
WantedBy=multi-user.target
