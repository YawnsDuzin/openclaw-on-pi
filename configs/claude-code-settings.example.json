{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": "실제 사용 시 ~/.claude/settings.json 으로 복사. 토큰은 별도 ~/.claude/credentials.json 에 저장되며 본 파일에는 절대 포함 금지.",

  "model": "claude-sonnet-4-6",
  "theme": "dark",

  "permissions": {
    "allow": [
      "Read(*)",
      "Glob(*)",
      "Grep(*)",
      "Edit(./**)",
      "Write(./**)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push)",
      "Bash(npm install)",
      "Bash(npm test)",
      "Bash(pytest:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(rg:*)"
    ],
    "deny": [
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Bash(chmod 777:*)",
      "Write(/etc/**)",
      "Write(~/.ssh/**)",
      "Write(~/.claude/**)"
    ],
    "additionalDirectories": []
  },

  "env": {
    "_comment": "OpenClaw 가 워크디렉토리를 명시적으로 넘기는 것을 권장. 여기서는 빈 값.",
    "CLAUDE_PROJECT_DIR": ""
  },

  "hooks": {
    "_comment": "원하는 경우 .claude/hooks/ 의 스크립트 경로를 지정. 예제는 비활성 상태."
  }
}
