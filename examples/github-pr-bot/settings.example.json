{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": "github-pr-bot 전용 권한 화이트리스트. ~/.claude/settings.json 으로 머지하거나 --settings 플래그로 전달.",

  "model": "claude-sonnet-4-6",

  "permissions": {
    "allow": [
      "Read(*)",
      "Glob(*)",
      "Grep(*)",
      "Edit(./**)",
      "Write(./**)",

      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git branch:*)",
      "Bash(git push origin:*)",

      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr view:*)",

      "Bash(npm test)",
      "Bash(npm run lint:*)",
      "Bash(pytest:*)",
      "Bash(make test)",

      "Bash(jq:*)",
      "Bash(cat:*)",
      "Bash(ls:*)"
    ],
    "deny": [
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(sudo:*)",

      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin master:*)",
      "Bash(git reset --hard:*)",
      "Bash(git branch -D:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh release delete:*)",

      "Bash(npm install:*)",
      "Bash(npm uninstall:*)",
      "Bash(pip install:*)",
      "Bash(pip uninstall:*)",

      "Edit(.github/**)",
      "Edit(scripts/**)",
      "Edit(**/*.lock)",
      "Edit(**/package-lock.json)",
      "Edit(**/pnpm-lock.yaml)",
      "Edit(**/yarn.lock)",
      "Write(.github/**)",
      "Write(scripts/**)",
      "Write(/etc/**)",
      "Write(~/.ssh/**)",
      "Write(~/.claude/**)"
    ]
  }
}
