# --- Secrets / credentials -------------------------------------------------
# Claude Code OAuth artifacts must never enter git
.claude/credentials.json
.claude/.credentials*
**/.claude/credentials.json
**/.claude/.credentials*

# Generic secret patterns
*.pem
*.key
*.p12
*.pfx
.env
.env.*
!.env.example
secrets/
credentials/

# --- Local working configs (real, not example) -----------------------------
configs/openclaw.yaml
configs/claude-code-settings.json
configs/CLAUDE.md
!configs/*.example.*
!configs/CLAUDE.example.md

